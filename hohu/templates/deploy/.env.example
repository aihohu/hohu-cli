# =============================================
# hohu-admin Docker Compose 环境变量配置
# 复制本文件为 .env 并修改各项配置
# cp .env.example .env
# =============================================

# ---------- 镜像配置 ----------
# 官方镜像（默认，直接部署）
# API_IMAGE=ghcr.io/aihohu/hohu-admin
# WEB_IMAGE=ghcr.io/aihohu/hohu-admin-web
#
# 使用自定义镜像（用户自己构建推送到自己的 Registry）：
# API_IMAGE=ghcr.io/your-org/hohu-admin
# WEB_IMAGE=ghcr.io/your-org/hohu-admin-web
#
# 或使用 Docker Hub：
# API_IMAGE=your-dockerhub-user/hohu-admin
# WEB_IMAGE=your-dockerhub-user/hohu-admin-web

# 镜像标签（版本号或 latest）
IMAGE_TAG=latest

# ---------- PostgreSQL ----------
POSTGRES_USER=hohu
POSTGRES_PASSWORD=hohu_secret_6789
POSTGRES_DB=hohu_admin

# ---------- Redis ----------
REDIS_PASSWORD=hohu_redis_6789

# ---------- 后端应用 ----------
# JWT 签名密钥，务必修改！
# 生成方式: openssl rand -hex 32
SECRET_KEY=change_me_in_production
# Token 过期时间（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Snowflake ID Worker (1-1023)，多实例部署时每个实例必须不同
WORKER_ID=1
# Uvicorn worker 进程数，建议设为 CPU 核心数
UVICORN_WORKERS=4

# ---------- Nginx ----------
# 域名
DOMAIN=localhost
# HTTP/HTTPS 端口
HTTP_PORT=80
HTTPS_PORT=443
# SSL 证书目录（需要包含 fullchain.pem 和 privkey.pem）
SSL_CERT_PATH=./ssl

# ---------- SSL / Certbot ----------
# 方式一：手动放置证书（默认）
#   将 fullchain.pem 和 privkey.pem 放入 SSL_CERT_PATH 目录
#
# 方式二：Let's Encrypt 自动证书（推荐生产环境）
#   1. 设置 DOMAIN 为你的域名
#   2. 将 SSL_CERT_PATH 指向 certbot 证书目录：
#      SSL_CERT_PATH=./certbot/live/${DOMAIN}
#   3. 首次申请证书：
#      docker compose run --rm -p 80:80 certbot certonly \
#        --webroot -w /var/www/certbot \
#        -d ${DOMAIN} \
#        --email your-email@example.com \
#        --agree-tos --no-eff-email
#   4. 启用自动续期（后台）：
#      docker compose --profile certbot up -d certbot
#
# Certbot 证书目录说明：
#   证书文件: /etc/letsencrypt/live/${DOMAIN}/fullchain.pem
#   私钥文件: /etc/letsencrypt/live/${DOMAIN}/privkey.pem
#   这些文件通过 certbot-conf volume 挂载到 nginx 容器

# ---------- 自签名证书（仅用于测试） ----------
# 如需快速生成自签名证书用于测试，取消下方注释
# SSL_CERT_PATH=./ssl-selfsigned
