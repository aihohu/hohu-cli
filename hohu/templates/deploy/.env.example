# =============================================
# hohu-admin Docker Compose 环境变量配置
# 复制本文件为 .env 并修改各项配置
# cp .env.example .env
# =============================================

# ---------- 镜像配置 ----------
# 官方镜像（默认，直接部署）
# API_IMAGE=ghcr.io/aihohu/hohu-admin
# WEB_IMAGE=ghcr.io/aihohu/hohu-admin-web
#
# 使用自定义镜像（用户自己构建推送到自己的 Registry）：
# API_IMAGE=ghcr.io/your-org/hohu-admin
# WEB_IMAGE=ghcr.io/your-org/hohu-admin-web
#
# 或使用 Docker Hub：
# API_IMAGE=your-dockerhub-user/hohu-admin
# WEB_IMAGE=your-dockerhub-user/hohu-admin-web

# 镜像标签（版本号或 latest）
IMAGE_TAG=latest

# ---------- PostgreSQL ----------
POSTGRES_USER=hohu
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_DB=hohu_admin

# ---------- Redis ----------
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>

# ---------- 后端应用 ----------
# JWT 签名密钥（hohu deploy init 自动生成）
SECRET_KEY=<YOUR_SECRET_KEY>
# Token 过期时间（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Snowflake ID Worker (1-1023)，多实例部署时每个实例必须不同
WORKER_ID=1
# Uvicorn worker 进程数，建议设为 CPU 核心数
UVICORN_WORKERS=4

# ---------- Nginx ----------
# 是否启用内置 Nginx 反向代理（默认关闭，需要时开启）
ENABLE_NGINX=false
# 域名（用于 SSL 证书申请）
DOMAIN=localhost
# HTTP/HTTPS 端口（启用 Nginx 后生效）
HTTP_PORT=80
HTTPS_PORT=443
# ---------- 端口暴露 ----------
# 默认不暴露，按需开启。留空或注释掉则不暴露。
# 绑定 0.0.0.0 外部访问可访问，如需仅本地访问改为 127.0.0.1
# WEB_PORT=0.0.0.0:8080
# API_PORT=0.0.0.0:8000
# PG_PORT=0.0.0.0:5432
# REDIS_PORT=0.0.0.0:6379

# ---------- SSL ----------
# 启用 HTTPS（需要同时启用 Nginx）
ENABLE_SSL=false
# SSL 证书目录（需要包含 fullchain.pem 和 privkey.pem）
SSL_CERT_PATH=./ssl

# 启用 SSL 步骤：
#   1. 将 ENABLE_NGINX 改为 true
#   2. 配置 SSL 证书（以下三种方式任选其一）
#   3. 将 ENABLE_SSL 改为 true
#   4. 重新部署: hohu deploy
#
# 方式一：手动放置证书
#   将 fullchain.pem 和 privkey.pem 放入 SSL_CERT_PATH 目录（默认 ./ssl/）
#   适用于：已有证书文件（从 CA 购买、自签名等）
#
# 方式二：Cloudflare Origin 证书
#   1. 登录 Cloudflare Dashboard → SSL/TLS → Origin Server
#   2. 创建 Origin 证书，下载 fullchain.pem 和 privkey.pem
#   3. 放入 ./ssl/ 目录
#   4. Cloudflare SSL 模式设为 "Full (Strict)"
#
# 方式三：Let's Encrypt（推荐生产环境）
#   1. 设置 DOMAIN 为你的域名
#   2. 首次申请证书：
#      docker compose run --rm -p 80:80 certbot certonly \
#        --webroot -w /var/www/certbot \
#        -d YOUR_DOMAIN \
#        --email your-email@example.com \
#        --agree-tos --no-eff-email
#   3. 修改证书路径：
#      SSL_CERT_PATH=/etc/letsencrypt/live/YOUR_DOMAIN
#   4. 设置 ENABLE_SSL=true
#   5. 启用自动续期（后台）：
#      docker compose --profile certbot up -d certbot

# ---------- 使用自己的 Nginx ----------
# 如果服务器已有 Nginx，设置 ENABLE_NGINX=false 即可：
#   1. 将 ENABLE_NGINX 改为 false
#   2. 在你的 nginx 配置中 include nginx/proxy-snippet.conf
#   3. proxy_pass http://127.0.0.1:8080（默认 WEB_PORT）
