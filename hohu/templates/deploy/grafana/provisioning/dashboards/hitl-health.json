{
  "annotations": { "list": [] },
  "description": "HITL 模式健康度：挂起数 / 超时率 / Pub-Sub 丢失率 / Wake 结果 / Redis 故障影响。对应 critical 2 + warning 1 条 alerts.yml 规则。",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "hohu-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hohu-prometheus" },
          "editorMode": "code",
          "expr": "sum(ai_hitl_pending_count)",
          "legendFormat": "",
          "range": false,
          "refId": "A",
          "instant": true
        }
      ],
      "title": "当前挂起数",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "hohu-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hohu-prometheus" },
          "editorMode": "code",
          "expr": "100 * sum(rate(ai_hitl_timeout_total[5m])) / clamp_min(sum(rate(ai_tool_calls_total{execution_mode=\"hitl\"}[5m])), 0.001)",
          "legendFormat": "",
          "range": false,
          "refId": "A",
          "instant": true
        }
      ],
      "title": "HITL 超时率 %（阈值 10%）",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "hohu-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hohu-prometheus" },
          "editorMode": "code",
          "expr": "100 * sum(rate(ai_hitl_pubsub_lost_total[5m])) / clamp_min(sum(rate(ai_hitl_wake_total{mode=\"redis_pubsub\"}[5m])), 0.001)",
          "legendFormat": "",
          "range": false,
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Pub/Sub 丢失率 %（阈值 1%）",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "hohu-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [] },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hohu-prometheus" },
          "editorMode": "code",
          "expr": "sum by (mode) (rate(ai_hitl_timeout_total{mode=~\"$mode\"}[5m]))",
          "legendFormat": "{{mode}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "超时趋势（按 mode）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "hohu-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [] },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hohu-prometheus" },
          "editorMode": "code",
          "expr": "sum by (result) (rate(ai_hitl_wake_total[5m]))",
          "legendFormat": "{{result}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Wake 结果分布",
      "type": "piechart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "hohu-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hohu-prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(ai_tool_calls_total{status=\"redis_down\"}[5m]))",
          "legendFormat": "redis_down",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Redis 故障影响（>0 即触发 critical）",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["hohu", "hitl"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "hohu-prometheus" },
        "definition": "label_values(ai_hitl_timeout_total, mode)",
        "hide": 0,
        "includeAll": true,
        "label": "mode",
        "multi": true,
        "name": "mode",
        "options": [],
        "query": { "query": "label_values(ai_hitl_timeout_total, mode)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "HITL Health",
  "uid": "hohu-hitl-health",
  "version": 1,
  "weekStart": ""
}
